TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
CLIENT_SECRET=your-discord-client-secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
WEB_SESSION_SECRET=replace-with-a-random-value-at-least-32-characters

# Website-only local development (separate from MONGODB_URI / TACTIOPBOT)
TACTIOBOT_DEV_MONGODB_URI=mongodb://127.0.0.1:27017
TACTIOBOT_DEV_MONGODB_DB_NAME=TACTIOPBOT_DEV_LOCAL
TACTIOBOT_DEV_PORT=3000
TACTIOBOT_DEV_GOOGLE_OAUTH_ENABLED=false
TACTIOBOT_DEV_GOOGLE_CLIENT_ID=your-development-google-oauth-client-id
TACTIOBOT_DEV_GOOGLE_CLIENT_SECRET=your-development-google-oauth-client-secret
TACTIOBOT_DEV_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Shared
PORT=3000
MONGODB_URI=your-mongodb-atlas-connection-string
# WhatsApp Cloud API (Meta official)
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
