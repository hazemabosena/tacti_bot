DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# OpenAI
OPENAI_API_KEY=
# Optional: default model used by openai_ai.js
OPENAI_MODEL=gpt-4o-mini

# AI behavior
# Chance (0-100). Your requirement: ~1
AI_RANDOM_PERCENT=1
# Cooldown per user per channel in ms
AI_COOLDOWN_MS=30000
# Optional prompts
AI_SYSTEM_PROMPT="You are Tactiopbot, a helpful Discord bot for Tacticool. Keep replies short, friendly, and relevant. If the user asks about Tacticool stats or operators, be helpful."
AI_CONTEXT="If you are unsure, ask a short follow-up question."
AI_MAX_TOKENS=180
AI_TEMPERATURE=0.8

# Tacticool API URL override (used by !tacticool)
TACTICOOL_API_URL=http://localhost:3000/api/tacticool

