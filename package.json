{
  "name": "new-generate",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "start:discord": "node index.js",
    "start:whatsapp": "node whatsappBot.js",
    "start:wa-cloud": "node whatsappCloudBot.js",
    "postinstall": "node -e \"const {execSync}=require('child_process'); if(process.platform==='linux'){execSync('npm install --no-save @napi-rs/canvas-linux-x64-gnu',{stdio:'inherit'});} else {console.log('Skipping linux-only canvas binary on', process.platform);}\"",
    "fetch-font": "node downloadFont.js",
    "register-commands": "node deploy-commands.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "canvas": "^3.2.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.1"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-win32-x64-msvc": "^0.1.97"
  }
}
